# ThinkQuality Studio — copy to .env.local and fill in.
# .env.local is git-ignored. Never commit real keys.

# --- Model provider --------------------------------------------------------
# Set ONE of the two keys. Both are server-side only; neither reaches the
# browser. If both are set, OpenRouter wins — override with AI_PROVIDER.
#
# A) Anthropic direct — console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-...
#
# B) OpenRouter — one key, every vendor. openrouter.ai/keys
# OPENROUTER_API_KEY=sk-or-v1-...
#
# AI_PROVIDER=anthropic|openrouter   (optional; inferred from the key above)

# Optional: override the two tiers behind the header quality switch.
# Defaults: Claude Sonnet 5 (standard) and Claude Opus 5 (quality).
# On OpenRouter, any id from openrouter.ai/models works — prefix with the
# vendor, e.g. anthropic/claude-opus-5, openai/gpt-5.6-sol,
# google/gemini-3.7-flash, deepseek/deepseek-v4-pro-0813.
# AI_MODEL_STANDARD=anthropic/claude-sonnet-5
# AI_MODEL_QUALITY=anthropic/claude-opus-5

# --- Supabase --------------------------------------------------------------
# Project Settings → API. The anon key is public by design; the service-role
# key is not — it bypasses RLS and must stay server-side.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# --- Access ----------------------------------------------------------------
# Comma-separated. Only these addresses can request a sign-in code.
ALLOWED_EMAILS=abdalrhmankurdi12@gmail.com

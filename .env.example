# ThinkQuality Studio — copy to .env.local and fill in.
# .env.local is git-ignored. Never commit real keys.

# --- Model provider --------------------------------------------------------
# OpenRouter is the default path — one key, every vendor. Both keys below are
# server-side only; neither reaches the browser.
#
# A) OpenRouter (default) — openrouter.ai/keys
OPENROUTER_API_KEY=
#
# B) Anthropic direct (alternative) — console.anthropic.com. Requires
#    AI_PROVIDER=anthropic to activate; without it, an ANTHROPIC_API_KEY here
#    is only used when OPENROUTER_API_KEY is blank.
# ANTHROPIC_API_KEY=
# AI_PROVIDER=anthropic

# Optional: override the two tiers behind the header quality switch.
# Defaults on OpenRouter, USD per million tokens (read 2026-08-15 from
# https://openrouter.ai/api/v1/models):
#   openai/gpt-5.6-luna    in $0.10  out $0.60   (standard)
#   qwen/qwen3.7-plus      in $0.32  out $1.28   (high)
# Any id from openrouter.ai/models works — prefix with the vendor, e.g.
# anthropic/claude-opus-5, google/gemini-3.7-flash,
# deepseek/deepseek-v4-pro-0813.
# AI_MODEL_STANDARD=openai/gpt-5.6-luna
# AI_MODEL_QUALITY=qwen/qwen3.7-plus

# --- Supabase --------------------------------------------------------------
# Project Settings → API. The anon key is public by design; the service-role
# key is not — it bypasses RLS and must stay server-side.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# --- Access ----------------------------------------------------------------
# Comma-separated. Only these addresses can request a sign-in code.
ALLOWED_EMAILS=abdalrhmankurdi12@gmail.com

# --- Instagram accounts ----------------------------------------------------
# The two handles, exactly as Instagram spells them. Proven from the scrape
# that produced every stored post. Blank falls back to these same values.
IG_HANDLE_PERSONAL=ahmadkahtan_
IG_HANDLE_ACADEMY=thinkquality_academyy

# --- Scrape budget + limits ------------------------------------------------
# Spend ceiling in USD for a single scrape action. Blank = no ceiling; a cost
# that cannot be estimated is blocked either way.
APIFY_BUDGET_USD=
# How many top posts get their comments pulled, and how many comments each.
COMMENTS_TOP_N=50
COMMENTS_PER_POST=100
# Mirror post media into Supabase storage. Off unless explicitly enabled.
MIRROR_MEDIA=false

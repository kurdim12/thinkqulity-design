{
  "name": "thinkquality-studio",
  "version": "1.0.0",
  "private": true,
  "description": "Brand strategist + creative director workspace for Think Quality Academy, by ALKURDI Studio.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "cf:build": "node scripts/cf-build.mjs",
    "cf:preview": "npm run cf:build && opennextjs-cloudflare preview",
    "cf:deploy": "npm run cf:build && opennextjs-cloudflare deploy",
    "test": "node --test --experimental-strip-types tests/*.test.ts",
    "seed": "node --env-file=.env.local --experimental-strip-types scripts/seed.ts",
    "doctor": "node --env-file=.env.local scripts/doctor.mjs",
    "login": "node --env-file=.env.local scripts/login-link.mjs",
    "set-password": "node --env-file=.env.local scripts/set-password.mjs",
    "ingest:knowledge": "node --env-file=.env.local scripts/ingest-knowledge.mjs",
    "assets": "node --env-file=.env.local scripts/upload-assets.mjs",
    "ingest:canon": "node --env-file=.env.local scripts/ingest-canon.mjs",
    "demo:check": "node --env-file=.env.local scripts/demo-check.mjs",
    "bakeoff": "node --env-file=.env.local scripts/bakeoff.mjs"
  },
  "dependencies": {
    "@ant-design/icons": "^5.5.2",
    "@ant-design/nextjs-registry": "^1.0.2",
    "@ant-design/v5-patch-for-react-19": "^1.0.3",
    "@anthropic-ai/sdk": "^0.117.1",
    "@supabase/ssr": "^0.5.2",
    "@supabase/supabase-js": "^2.47.10",
    "antd": "^5.22.5",
    "dayjs": "^1.11.13",
    "next": "^15.1.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^9.0.1",
    "remark-gfm": "^4.0.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "^1.20.2",
    "@types/node": "^22.10.5",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "typescript": "^5.7.2",
    "wrangler": "^4.123.0"
  }
}
